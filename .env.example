# ==========================================
# FitBuddy — AI Fitness Plan Generator
# Master Environment Variables Configuration
# ==========================================

# ----------------- BACKEND CONFIG -----------------
# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL
# Local Development (SQLite): sqlite:///./fitbuddy.db
# Production (Supabase / Neon / Render PostgreSQL): postgresql://user:password@host:port/database_name
DATABASE_URL=sqlite:///./fitbuddy.db

# Admin Security Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=fitbuddy_admin_2026

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Backend Server Port (Default: 8000)
PORT=8000


# ----------------- FRONTEND CONFIG -----------------
# Base URL of the backend API (set in frontend/.env)
# For local development: http://localhost:8000
# For production (Vercel): https://your-backend-api.vercel.app or leave empty if served under same domain
VITE_API_URL=http://localhost:8000
