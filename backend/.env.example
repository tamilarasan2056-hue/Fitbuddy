# FitBuddy Backend Environment Variables

# Gemini API Key (Obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL
# For local SQLite: sqlite:///./fitbuddy.db
# For production PostgreSQL (Supabase, Neon, Railway): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./fitbuddy.db

# Admin Credentials for Protected Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=fitbuddy_admin_2026

# Allowed CORS Origins (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Port
PORT=8000
